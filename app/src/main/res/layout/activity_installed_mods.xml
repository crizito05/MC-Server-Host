<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/buttonCheckUpdates"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:gravity="center"
            android:text="Verifica aggiornamenti" />

        <Button
            android:id="@+id/buttonUpdateAll"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:gravity="center"
            android:enabled="false"
            android:text="Aggiorna tutto" />

    </LinearLayout>

    <TextView
        android:id="@+id/textEmptyInstalled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nessuna mod installata"
        android:gravity="center"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInstalledMods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>