<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="88dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Per giocare da fuori casa serve un tunnel. L'app usa playit.gg: puoi attivare l'agente dal telefono senza computer, oppure incollare qui il segreto dell'agente ottenuto dal sito o dal computer. Il segreto resta sul telefono, custodito nel keystore Android."
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonClaimSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Attiva agente dal telefono" />

            <EditText
                android:id="@+id/inputSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Incolla il segreto di playit.gg"
                android:inputType="textNoSuggestions"
                android:maxLines="3" />

            <Button
                android:id="@+id/buttonSaveSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Salva segreto" />

            <Button
                android:id="@+id/buttonStartStopAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Avvia agente" />

            <Button
                android:id="@+id/buttonRefreshTunnels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Leggi indirizzi" />

            <TextView
                android:id="@+id/textNetworkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerTunnels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Log dell'agente"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/networkLogScroll"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="4dp"
                android:background="#000000">

                <TextView
                    android:id="@+id/textNetworkLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#00FF00"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

            </ScrollView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabHelp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Apri la guida"
        android:src="@android:drawable/ic_menu_help" />

</FrameLayout>