<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/buttonNewServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_new_server"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_network" />

    <Button
        android:id="@+id/buttonInstallLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/main_install_logs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_single_server_note"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_empty"
        android:gravity="center"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerServers"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>