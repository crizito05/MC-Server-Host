<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/buttonNewServer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuovo server"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/buttonNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connessione dall'esterno" />

    <Button
        android:id="@+id/buttonInstallLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Log di installazione" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Puoi tenere acceso un solo server alla volta, per stabilità e compatibilità"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nessun server creato"
        android:gravity="center"
        android:layout_marginTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerServers"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>